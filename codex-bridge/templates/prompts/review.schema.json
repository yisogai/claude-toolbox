{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "summary", "next_steps"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["approve", "needs-attention"],
      "description": "blocking / major が 1 件でもあれば needs-attention"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line_start", "line_end", "category", "title", "description", "confidence"],
        "properties": {
          "severity": { "type": "string", "enum": ["blocking", "major", "minor", "nit"] },
          "file": { "type": "string", "description": "リポジトリルートからの相対パス" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "category": {
            "type": "string",
            "description": "correctness | edge-case | regression | security | performance | maintainability | docs"
          },
          "title": { "type": "string", "description": "1 行要約" },
          "description": { "type": "string", "description": "どこが・なぜ壊れるか・どの入力で顕在化するか" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "全体所見。指摘が 0 件なら「何を確認して無いと判断したか」を書く"
    },
    "next_steps": { "type": "array", "items": { "type": "string" } }
  }
}
